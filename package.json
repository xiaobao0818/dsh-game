    "index.js",
    "cordis.patch.yml",
    "engine",
    "skills",
    "docs",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "game",
    "game-development",
    "generator",
    "html5",
    "plugin",
    "game-studio"
  ],
